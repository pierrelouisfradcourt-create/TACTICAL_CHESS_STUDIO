{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/studiopilot_local_review_pack.schema.json",
  "title": "StudioPilot Local Review Pack V0",
  "description": "Compact local control-plane review pack for HumanGate review. This schema does not authorize execution, ready state, merge, evidence claims, promotion, or external API calls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "source_pr_number",
    "source_head_sha",
    "execution_report_status",
    "review_packet_status",
    "human_decision_status",
    "pr_decision_packet_status",
    "scope_status",
    "checks_status",
    "software_verdict",
    "evidence_verdict",
    "claim_verdict",
    "recommended_decision",
    "next_action",
    "human_gate_required",
    "auto_ready_allowed",
    "auto_merge_allowed",
    "touched_surfaces",
    "risks",
    "summary_lines"
  ],
  "properties": {
    "schema_version": {
      "const": "studiopilot.local_review_pack.v0"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "source_pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_head_sha": {
      "type": "string",
      "minLength": 1
    },
    "execution_report_status": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "NOT_REQUIRED"
      ]
    },
    "review_packet_status": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "NOT_REQUIRED"
      ]
    },
    "human_decision_status": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "PENDING"
      ]
    },
    "pr_decision_packet_status": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "INVALID"
      ]
    },
    "scope_status": {
      "type": "string",
      "enum": [
        "OK",
        "WARNING",
        "VIOLATION",
        "UNKNOWN"
      ]
    },
    "checks_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PENDING",
        "FAILED",
        "BLOCKED_INFRA",
        "UNKNOWN"
      ]
    },
    "software_verdict": {
      "type": "string",
      "enum": [
        "SAFE",
        "RISKY",
        "BLOCKED",
        "BLOCKED_INFRA"
      ]
    },
    "evidence_verdict": {
      "type": "string",
      "minLength": 1
    },
    "claim_verdict": {
      "type": "string",
      "enum": [
        "NO_CLAIM_ALLOWED",
        "HEALTH_ONLY",
        "EVIDENCE_ONLY"
      ]
    },
    "recommended_decision": {
      "type": "string",
      "enum": [
        "GO",
        "GO_READY_AND_MERGE",
        "HOLD",
        "BLOCKED",
        "BLOCKED_INFRA"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "human_gate_required": {
      "const": true
    },
    "auto_ready_allowed": {
      "const": false
    },
    "auto_merge_allowed": {
      "const": false
    },
    "touched_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows",
        "runtime",
        "search",
        "neural",
        "ml_training",
        "benchmark",
        "schemas",
        "docs",
        "control_plane_tooling"
      ],
      "properties": {
        "workflows": {
          "type": "boolean"
        },
        "runtime": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "neural": {
          "type": "boolean"
        },
        "ml_training": {
          "type": "boolean"
        },
        "benchmark": {
          "type": "boolean"
        },
        "schemas": {
          "type": "boolean"
        },
        "docs": {
          "type": "boolean"
        },
        "control_plane_tooling": {
          "type": "boolean"
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/studiopilot_execution_report.schema.json",
  "title": "StudioPilot ExecutionReport V0",
  "description": "Structured Codex execution report. A Codex report is not canonical evidence by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "branch",
    "changed_files",
    "commands_run",
    "commands_skipped",
    "validation_results",
    "tests_passed",
    "tests_failed",
    "known_risks",
    "scope_deviation",
    "claim_verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands_skipped": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "UNKNOWN"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "tests_passed": {
      "type": "integer",
      "minimum": 0
    },
    "tests_failed": {
      "type": "integer",
      "minimum": 0
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_deviation": {
      "type": "string",
      "enum": [
        "NONE",
        "MINOR",
        "MAJOR",
        "BLOCKING"
      ]
    },
    "claim_verdict": {
      "type": "string",
      "enum": [
        "NO_CLAIM_ALLOWED",
        "HEALTH_ONLY",
        "EVIDENCE_ONLY"
      ]
    }
  }
}

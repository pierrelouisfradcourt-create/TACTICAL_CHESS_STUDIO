{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/humangate_decision_candidate.schema.json",
  "title": "HumanGateDecisionCandidate V0",
  "description": "Stdout-only dry-run HumanGate decision candidate compiled from a StudioOperatorInbox. This schema does not authorize persistence, Codex execution, runtime activation, dataset generation, training, benchmark, model promotion, release automation, or public claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "contract_version",
    "generated_at",
    "source_inbox_id",
    "decision_id",
    "decision",
    "scope",
    "approved_actions",
    "blocked_actions",
    "expires_after",
    "humangate_required",
    "operator_notes",
    "claim_posture",
    "no_global_ready_verdict"
  ],
  "properties": {
    "record_type": {
      "const": "humangate_decision_candidate"
    },
    "contract_version": {
      "const": "V0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_inbox_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve_next_mission_candidate",
        "reject_next_mission_candidate",
        "request_read_only_audit",
        "defer"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source",
        "execution_authorized",
        "persistent_state_authorized",
        "claim_authorized"
      ],
      "properties": {
        "mode": {
          "const": "DRY_RUN_DECISION_CANDIDATE"
        },
        "source": {
          "const": "studio_operator_inbox"
        },
        "execution_authorized": {
          "const": false
        },
        "persistent_state_authorized": {
          "const": false
        },
        "claim_authorized": {
          "const": false
        }
      }
    },
    "approved_actions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/approved_action"
      }
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "runtime_activation"
          }
        },
        {
          "contains": {
            "const": "dataset_generation"
          }
        },
        {
          "contains": {
            "const": "training"
          }
        },
        {
          "contains": {
            "const": "benchmark"
          }
        },
        {
          "contains": {
            "const": "model_promotion"
          }
        },
        {
          "contains": {
            "const": "public_claim"
          }
        },
        {
          "contains": {
            "const": "push"
          }
        },
        {
          "contains": {
            "const": "branch"
          }
        },
        {
          "contains": {
            "const": "pr"
          }
        },
        {
          "contains": {
            "const": "codex_auto_execution"
          }
        }
      ]
    },
    "expires_after": {
      "type": "string",
      "minLength": 1
    },
    "humangate_required": {
      "const": true
    },
    "operator_notes": {
      "type": "string",
      "minLength": 1
    },
    "claim_posture": {
      "const": "NO_CLAIM_ALLOWED"
    },
    "no_global_ready_verdict": {
      "const": true
    }
  },
  "$defs": {
    "approved_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "scope",
        "mission_goal",
        "mission_source",
        "execution_authorized"
      ],
      "properties": {
        "action": {
          "const": "approve_next_mission_candidate"
        },
        "scope": {
          "const": "single_next_mission_candidate"
        },
        "mission_goal": {
          "type": "string",
          "minLength": 1
        },
        "mission_source": {
          "type": "string",
          "minLength": 1
        },
        "execution_authorized": {
          "const": false
        }
      }
    }
  }
}

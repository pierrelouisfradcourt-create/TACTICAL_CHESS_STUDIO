{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/freeze_rules.schema.json",
  "title": "FreezeRules",
  "description": "Immediate freeze rules for prohibited behavior and autonomy overruns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "freeze_immediately_on",
    "thaw_authority"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "freeze_immediately_on": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "forbidden_file_touched",
          "test_or_ci_modified_to_mask_failure",
          "invented_performance_claim",
          "benchmark_treated_as_proof",
          "agent_self_scores",
          "autonomy_exceeded"
        ]
      }
    },
    "thaw_authority": {
      "type": "string",
      "const": "HUMAN_ONLY"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/full_studio_loop_in_memory_result.schema.json",
  "title": "FullStudioLoopInMemoryResult V0",
  "description": "Read-only in-memory integration harness result for ExecutionReport through SemiAutoStudioLoopDryRun. This schema does not authorize persistence, Codex execution, runtime activation, training, benchmark, model promotion, release automation, or public claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "contract_version",
    "source_report",
    "decision",
    "delta_status",
    "snapshot_status",
    "current_state_preview_status",
    "mission_candidate_status",
    "operator_inbox_status",
    "humangate_decision_status",
    "authorized_action_plan_status",
    "semi_auto_loop_status",
    "execution_performed",
    "codex_execution_performed",
    "persistence_performed",
    "current_state_modified",
    "inbox_persisted",
    "claim_posture",
    "no_global_ready_verdict"
  ],
  "properties": {
    "record_type": {
      "const": "full_studio_loop_in_memory_result"
    },
    "contract_version": {
      "const": "V0"
    },
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "task_id",
        "source_report_id",
        "source_task_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "source_report_id": {
          "type": "string",
          "minLength": 1
        },
        "source_task_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve_next_mission_candidate",
        "reject_next_mission_candidate",
        "request_read_only_audit",
        "defer"
      ]
    },
    "delta_status": {
      "$ref": "#/$defs/status"
    },
    "snapshot_status": {
      "$ref": "#/$defs/status"
    },
    "current_state_preview_status": {
      "$ref": "#/$defs/status"
    },
    "mission_candidate_status": {
      "$ref": "#/$defs/status"
    },
    "operator_inbox_status": {
      "$ref": "#/$defs/status"
    },
    "humangate_decision_status": {
      "$ref": "#/$defs/status"
    },
    "authorized_action_plan_status": {
      "$ref": "#/$defs/status"
    },
    "semi_auto_loop_status": {
      "$ref": "#/$defs/status"
    },
    "execution_performed": {
      "const": false
    },
    "codex_execution_performed": {
      "const": false
    },
    "persistence_performed": {
      "const": false
    },
    "current_state_modified": {
      "const": false
    },
    "inbox_persisted": {
      "const": false
    },
    "claim_posture": {
      "const": "NO_CLAIM_ALLOWED"
    },
    "no_global_ready_verdict": {
      "const": true
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "IMPLEMENTED",
        "TESTED",
        "DOCUMENTED_ONLY",
        "PASSIVE",
        "BLOCKED",
        "NOT_FOUND",
        "UNKNOWN"
      ]
    }
  }
}

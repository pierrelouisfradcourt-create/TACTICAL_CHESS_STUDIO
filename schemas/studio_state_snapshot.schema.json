{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/studio_state_snapshot.schema.json",
  "title": "StudioStateSnapshot V0",
  "description": "Stdout-only dry-run aggregate of StudioStateDelta records. This schema does not define persistent current state, activation authority, promotion authority, or claim authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "contract_version",
    "generated_at",
    "source_delta_ids",
    "proven_surfaces",
    "blocked_surfaces",
    "open_blockers",
    "open_risks",
    "decision_debt",
    "humangate_required_items",
    "next_best_mission",
    "forbidden_next_missions",
    "status_by_surface",
    "claim_posture",
    "no_global_ready_verdict"
  ],
  "properties": {
    "record_type": {
      "const": "studio_state_snapshot"
    },
    "contract_version": {
      "const": "V0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_delta_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proven_surfaces": {
      "$ref": "#/$defs/surface_list"
    },
    "blocked_surfaces": {
      "$ref": "#/$defs/surface_list"
    },
    "open_blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot_item"
      }
    },
    "open_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot_item"
      }
    },
    "decision_debt": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot_item"
      }
    },
    "humangate_required_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humangate_item"
      }
    },
    "next_best_mission": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/mission"
        }
      ]
    },
    "forbidden_next_missions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status_by_surface": {
      "$ref": "#/$defs/surface_status_map"
    },
    "claim_posture": {
      "const": "NO_CLAIM_ALLOWED",
      "default": "NO_CLAIM_ALLOWED"
    },
    "no_global_ready_verdict": {
      "const": true,
      "default": true
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "IMPLEMENTED",
        "TESTED",
        "DOCUMENTED_ONLY",
        "PASSIVE",
        "BLOCKED",
        "NOT_FOUND",
        "UNKNOWN"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "active_runtime_code",
        "tests",
        "tools_scripts",
        "artifacts_runtime_outputs",
        "canonical_docs",
        "roadmap_docs_only",
        "inference"
      ]
    },
    "surface_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      },
      "uniqueItems": true
    },
    "surface_status_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_runtime_code",
        "tests",
        "tools_scripts",
        "artifacts_runtime_outputs",
        "canonical_docs",
        "roadmap_docs_only",
        "inference"
      ],
      "properties": {
        "active_runtime_code": {
          "$ref": "#/$defs/status"
        },
        "tests": {
          "$ref": "#/$defs/status"
        },
        "tools_scripts": {
          "$ref": "#/$defs/status"
        },
        "artifacts_runtime_outputs": {
          "$ref": "#/$defs/status"
        },
        "canonical_docs": {
          "$ref": "#/$defs/status"
        },
        "roadmap_docs_only": {
          "$ref": "#/$defs/status"
        },
        "inference": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "snapshot_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "status",
        "source_delta_id"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_delta_id": {
          "type": "string",
          "minLength": 1
        },
        "source_task_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "humangate_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "status",
        "source_delta_id",
        "source_task_id"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source_delta_id": {
          "type": "string",
          "minLength": 1
        },
        "source_task_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "reason",
        "source"
      ],
      "properties": {
        "task_class": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "target_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_plan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

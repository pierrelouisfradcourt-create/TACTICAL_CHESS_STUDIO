{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/task_packet.schema.json",
  "title": "TaskPacket",
  "description": "Minimal control-plane packet used to assign bounded work to a registered agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent_id",
    "objective",
    "allowed_files",
    "forbidden_files",
    "required_checks",
    "expected_verdicts",
    "human_review_required",
    "control_plane_exception",
    "exception_reason",
    "authorization",
    "authorize_commit",
    "authorize_push",
    "authorize_create_pr",
    "authorize_ready_pr",
    "authorize_merge_pr"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "agent_id": {
      "type": "string",
      "enum": ["producer", "code", "review", "qa", "docs"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_verdict",
        "evidence_verdict",
        "claim_verdict"
      ],
      "properties": {
        "software_verdict": {
          "type": "string",
          "enum": [
            "CONTROL_PLANE_SCHEMA_ONLY",
            "CONTROL_PLANE_DOCS_ONLY",
            "CONTROL_PLANE_TOOLING_ONLY",
            "RUNTIME_CHANGE",
            "ML_CHANGE",
            "BLOCKED"
          ]
        },
        "evidence_verdict": {
          "type": "string",
          "enum": [
            "SCHEMA_AND_METADATA_INSPECTION_ONLY",
            "SCHEMA_AND_FIXTURE_VALIDATION_ONLY",
            "STRICT_SCHEMA_VALIDATION_ONLY",
            "LOCAL_OPERATOR_HYGIENE_VALIDATION_ONLY",
            "LOCAL_BLOCK_RUNNER_DRY_RUN_VALIDATION_ONLY",
            "TEST_LOGS_PRESENT",
            "BENCHMARK_OBSERVATION_ONLY",
            "BLOCKED"
          ]
        },
        "claim_verdict": {
          "type": "string",
          "enum": [
            "NO_CLAIM_ALLOWED",
            "CLAIM_SUPPORTED",
            "CLAIM_UNSUPPORTED",
            "BLOCKED"
          ]
        }
      }
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "control_plane_exception": {
      "type": "boolean"
    },
    "exception_reason": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_authorized",
        "allow_commit",
        "allow_push",
        "allow_create_pr",
        "allow_ready",
        "allow_merge"
      ],
      "properties": {
        "human_authorized": {
          "type": "boolean"
        },
        "allow_commit": {
          "type": "boolean"
        },
        "allow_push": {
          "type": "boolean"
        },
        "allow_create_pr": {
          "type": "boolean"
        },
        "allow_ready": {
          "type": "boolean",
          "const": false
        },
        "allow_merge": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "authorize_commit": {
      "type": "boolean"
    },
    "authorize_push": {
      "type": "boolean"
    },
    "authorize_create_pr": {
      "type": "boolean"
    },
    "authorize_ready_pr": {
      "type": "boolean",
      "const": false
    },
    "authorize_merge_pr": {
      "type": "boolean",
      "const": false
    }
  }
}

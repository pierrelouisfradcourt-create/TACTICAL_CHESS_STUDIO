{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/studiopilot_pr_decision_packet.schema.json",
  "title": "StudioPilot PRDecisionPacket V0",
  "description": "Compact local PR decision object for HumanGate review. This schema does not authorize ready state, merge, evidence claims, promotion, or external API calls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "pr_number",
    "pr_title",
    "head_sha",
    "branch",
    "scope_status",
    "checks_status",
    "software_verdict",
    "evidence_verdict",
    "claim_verdict",
    "merge_verdict",
    "human_gate_required",
    "auto_merge_allowed",
    "auto_ready_allowed",
    "recommended_decision",
    "reasons",
    "next_action",
    "touched_surfaces",
    "forbidden_surface_touched"
  ],
  "properties": {
    "schema_version": {
      "const": "studiopilot.pr_decision_packet.v0"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "pr_title": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "scope_status": {
      "type": "string",
      "enum": [
        "OK",
        "WARNING",
        "VIOLATION",
        "UNKNOWN"
      ]
    },
    "checks_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PENDING",
        "FAILED",
        "BLOCKED_INFRA",
        "UNKNOWN"
      ]
    },
    "software_verdict": {
      "type": "string",
      "enum": [
        "SAFE",
        "RISKY",
        "BLOCKED",
        "BLOCKED_INFRA"
      ]
    },
    "evidence_verdict": {
      "type": "string",
      "minLength": 1
    },
    "claim_verdict": {
      "type": "string",
      "enum": [
        "NO_CLAIM_ALLOWED",
        "HEALTH_ONLY",
        "EVIDENCE_ONLY"
      ]
    },
    "merge_verdict": {
      "type": "string",
      "enum": [
        "DRAFT_ONLY",
        "READY_ALLOWED",
        "MERGE_ALLOWED",
        "MERGE_BLOCKED"
      ]
    },
    "human_gate_required": {
      "const": true
    },
    "auto_merge_allowed": {
      "const": false
    },
    "auto_ready_allowed": {
      "const": false
    },
    "recommended_decision": {
      "type": "string",
      "enum": [
        "GO",
        "GO_READY_AND_MERGE",
        "HOLD",
        "BLOCKED",
        "BLOCKED_INFRA"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "touched_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows",
        "runtime",
        "search",
        "neural",
        "ml_training",
        "benchmark",
        "schemas",
        "docs",
        "control_plane_tooling"
      ],
      "properties": {
        "workflows": {
          "type": "boolean"
        },
        "runtime": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "neural": {
          "type": "boolean"
        },
        "ml_training": {
          "type": "boolean"
        },
        "benchmark": {
          "type": "boolean"
        },
        "schemas": {
          "type": "boolean"
        },
        "docs": {
          "type": "boolean"
        },
        "control_plane_tooling": {
          "type": "boolean"
        }
      }
    },
    "forbidden_surface_touched": {
      "type": "boolean"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/agent_profile.schema.json",
  "title": "AgentProfile",
  "description": "Control-plane agent registry profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "display_name",
    "role",
    "autonomy_level",
    "permissions",
    "allowed_surfaces",
    "forbidden_surfaces"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "enum": [
        "producer",
        "code",
        "review",
        "qa",
        "docs"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_write_files",
        "can_assign_tasks",
        "can_run_checks",
        "can_merge",
        "can_claim",
        "can_use_benchmark_as_proof"
      ],
      "properties": {
        "can_write_files": {
          "type": "boolean"
        },
        "can_assign_tasks": {
          "type": "boolean"
        },
        "can_run_checks": {
          "type": "boolean"
        },
        "can_merge": {
          "type": "boolean",
          "const": false
        },
        "can_claim": {
          "type": "boolean",
          "const": false
        },
        "can_use_benchmark_as_proof": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "allowed_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cannot_modify_agent_registry",
        "cannot_modify_own_policy",
        "human_review_required"
      ],
      "properties": {
        "cannot_modify_agent_registry": {
          "type": "boolean"
        },
        "cannot_modify_own_policy": {
          "type": "boolean"
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    }
  }
}

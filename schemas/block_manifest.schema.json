{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/block_manifest.schema.json",
  "title": "BlockManifest",
  "description": "Sequential local block-runner manifest with deny-by-default task execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "block_id",
    "default_mode",
    "stop_on_fail",
    "allow_commit",
    "allow_push",
    "allow_create_pr",
    "allow_ready",
    "allow_merge",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "block_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "default_mode": {
      "type": "string",
      "enum": [
        "inspect",
        "validate-staged",
        "dry-run"
      ]
    },
    "stop_on_fail": {
      "type": "boolean",
      "const": true
    },
    "allow_commit": {
      "type": "boolean",
      "const": false
    },
    "allow_push": {
      "type": "boolean",
      "const": false
    },
    "allow_create_pr": {
      "type": "boolean",
      "const": false
    },
    "allow_ready": {
      "type": "boolean",
      "const": false
    },
    "allow_merge": {
      "type": "boolean",
      "const": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task_packet",
          "mode",
          "required_gates"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "task_packet": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "inspect",
              "validate-staged",
              "dry-run"
            ]
          },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/authorized_next_action_plan.schema.json",
  "title": "AuthorizedNextActionPlan V0",
  "description": "Stdout-only dry-run plan compiled from a HumanGateDecisionCandidate. This schema does not authorize execution, Codex execution, persistence, activation, training, benchmark, model promotion, release automation, or public claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "contract_version",
    "generated_at",
    "source_decision_id",
    "decision",
    "action_status",
    "next_action",
    "codex_prompt_candidate",
    "allowed_actions",
    "blocked_actions",
    "expires_after",
    "execution_allowed",
    "codex_execution_allowed",
    "persistence_allowed",
    "claim_posture",
    "no_global_ready_verdict"
  ],
  "properties": {
    "record_type": {
      "const": "authorized_next_action_plan"
    },
    "contract_version": {
      "const": "V0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve_next_mission_candidate",
        "reject_next_mission_candidate",
        "request_read_only_audit",
        "defer"
      ]
    },
    "action_status": {
      "type": "string",
      "enum": [
        "AUTHORIZED_DRY_RUN_ONLY",
        "REJECTED",
        "DEFERRED",
        "AUDIT_REQUESTED",
        "BLOCKED"
      ]
    },
    "next_action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/next_action"
        }
      ]
    },
    "codex_prompt_candidate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      },
      "uniqueItems": true
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "runtime_activation"
          }
        },
        {
          "contains": {
            "const": "dataset_generation"
          }
        },
        {
          "contains": {
            "const": "training"
          }
        },
        {
          "contains": {
            "const": "benchmark"
          }
        },
        {
          "contains": {
            "const": "model_promotion"
          }
        },
        {
          "contains": {
            "const": "public_claim"
          }
        },
        {
          "contains": {
            "const": "push"
          }
        },
        {
          "contains": {
            "const": "branch"
          }
        },
        {
          "contains": {
            "const": "pr"
          }
        },
        {
          "contains": {
            "const": "codex_auto_execution"
          }
        }
      ]
    },
    "expires_after": {
      "type": "string",
      "minLength": 1
    },
    "execution_allowed": {
      "const": false
    },
    "codex_execution_allowed": {
      "const": false
    },
    "persistence_allowed": {
      "const": false
    },
    "claim_posture": {
      "const": "NO_CLAIM_ALLOWED"
    },
    "no_global_ready_verdict": {
      "const": true
    }
  },
  "$defs": {
    "next_action": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action",
        "summary",
        "execution_allowed"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "execution_allowed": {
          "const": false
        }
      }
    }
  }
}

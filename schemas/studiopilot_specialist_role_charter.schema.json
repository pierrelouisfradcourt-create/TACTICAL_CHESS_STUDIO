{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticalchesspurelab.local/schemas/studiopilot_specialist_role_charter.schema.json",
  "title": "StudioPilot Specialist Role Charter V0",
  "description": "Planning-only control-plane specialist role charter. Specialists provide bounded expertise and escalate to Director ownership without autonomous execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specialist_id",
    "specialist_type",
    "display_name",
    "director_owner",
    "mission",
    "inputs",
    "outputs",
    "allowed_actions",
    "forbidden_actions",
    "authority_level",
    "escalation_path",
    "freeze_conditions",
    "required_evidence",
    "permitted_surfaces",
    "forbidden_surfaces",
    "human_gate_required",
    "active_agent_allowed",
    "auto_ready_allowed",
    "auto_merge_allowed",
    "auto_training_allowed",
    "auto_rule_mutation_allowed",
    "claim_verdict",
    "status"
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1
    }
  },
  "properties": {
    "schema_version": {
      "const": "studiopilot.specialist_role_charter.v0"
    },
    "specialist_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "specialist_type": {
      "type": "string",
      "enum": [
        "RUNTIME_RUST_SPECIALIST",
        "ML_PYTHON_SPECIALIST",
        "GAME_DESIGN_SPECIALIST",
        "BALANCE_SIMULATION_SPECIALIST",
        "QA_REVIEW_SPECIALIST",
        "DOCS_SPECIALIST",
        "MEMORY_LEARNING_SPECIALIST",
        "FINANCE_COMPUTE_SPECIALIST",
        "SECURITY_IP_SPECIALIST"
      ]
    },
    "display_name": {
      "$ref": "#/$defs/non_empty_string"
    },
    "director_owner": {
      "type": "string",
      "enum": [
        "RESOURCE_DIRECTOR",
        "ARCHITECTURE_DIRECTOR",
        "PRODUCT_GAME_DIRECTOR",
        "QUALITY_DIRECTOR",
        "MEMORY_EVIDENCE_DIRECTOR"
      ]
    },
    "mission": {
      "$ref": "#/$defs/non_empty_string"
    },
    "inputs": {
      "$ref": "#/$defs/string_array"
    },
    "outputs": {
      "$ref": "#/$defs/string_array"
    },
    "allowed_actions": {
      "$ref": "#/$defs/string_array"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/string_array"
    },
    "authority_level": {
      "type": "string",
      "enum": [
        "ADVISORY_ONLY",
        "REVIEW_ONLY",
        "BOUNDED_IMPLEMENTATION_ADVICE",
        "ESCALATION_ONLY"
      ]
    },
    "escalation_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "RESOURCE_DIRECTOR",
          "ARCHITECTURE_DIRECTOR",
          "PRODUCT_GAME_DIRECTOR",
          "QUALITY_DIRECTOR",
          "MEMORY_EVIDENCE_DIRECTOR",
          "CEO_OFFICE",
          "CEO_PRODUCER",
          "GOVERNANCE_KERNEL",
          "HUMAN_FOUNDER"
        ]
      }
    },
    "freeze_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "scope_unclear",
          "forbidden_surface_requested",
          "human_gate_missing",
          "claim_boundary_unclear",
          "budget_risk",
          "runtime_risk",
          "ml_training_requested",
          "benchmark_automation_requested",
          "private_ip_risk"
        ]
      }
    },
    "required_evidence": {
      "$ref": "#/$defs/string_array"
    },
    "permitted_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows",
        "runtime",
        "search",
        "neural",
        "ml_training",
        "benchmark",
        "schemas",
        "docs",
        "control_plane_tooling"
      ],
      "properties": {
        "workflows": {
          "type": "boolean"
        },
        "runtime": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "neural": {
          "type": "boolean"
        },
        "ml_training": {
          "type": "boolean"
        },
        "benchmark": {
          "type": "boolean"
        },
        "schemas": {
          "type": "boolean"
        },
        "docs": {
          "type": "boolean"
        },
        "control_plane_tooling": {
          "type": "boolean"
        }
      }
    },
    "forbidden_surfaces": {
      "$ref": "#/$defs/string_array"
    },
    "human_gate_required": {
      "const": true
    },
    "active_agent_allowed": {
      "const": false
    },
    "auto_ready_allowed": {
      "const": false
    },
    "auto_merge_allowed": {
      "const": false
    },
    "auto_training_allowed": {
      "const": false
    },
    "auto_rule_mutation_allowed": {
      "const": false
    },
    "claim_verdict": {
      "type": "string",
      "enum": [
        "NO_CLAIM_ALLOWED",
        "HEALTH_ONLY",
        "EVIDENCE_ONLY"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_HUMAN_REVIEW",
        "ACCEPTED",
        "HOLD",
        "BLOCKED",
        "SUPERSEDED"
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "studio/factory/ir_schema_v1.json",
  "title": "GameIR v1 (universal)",
  "description": "Schema universel d'IR de jeu pour l'usine TCS. Generalise les deux formats divergents preexistants (studio_core/ir/game_ir_schema.json 'snake' et studio_core/factory/manifest.py 'chess'). Valide la STRUCTURE seulement — la logique des regles est remplie en aval par llm_logic_engine, jamais par la structure.",
  "type": "object",
  "required": ["meta", "entities", "rules"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name":    { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "game_type": {
          "type": "string",
          "description": "Indice de runtime non contraignant (ex: arcade_realtime, turn_based_strategy)."
        },
        "players":     { "type": "integer", "minimum": 1 },
        "turn_based":  { "type": "boolean" },
        "session_duration": { "type": "number", "exclusiveMinimum": 0 },
        "arena_width":      { "type": "number", "exclusiveMinimum": 0 },
        "arena_height":     { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "attributes"],
        "additionalProperties": true,
        "properties": {
          "id":   { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1, "description": "Type libre, non contraint par un enum (universel)." },
          "attributes": { "type": "object" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "description": "Liste declarative. Chaque regle expose condition/effect en clair ; le corps logique est rempli en aval (slot 'logic' du scaffold), jamais ici.",
      "items": {
        "type": "object",
        "required": ["rule", "condition", "effect"],
        "additionalProperties": true,
        "properties": {
          "rule":       { "type": "string", "minLength": 1 },
          "category":   { "type": "string" },
          "condition":  { "type": "string", "minLength": 1, "description": "Precondition lisible." },
          "effect":     { "type": "string", "minLength": 1, "description": "Effet applique quand la condition est vraie." },
          "parameters": { "type": "object" }
        }
      }
    },
    "win_conditions": {
      "type": "array",
      "description": "Conditions de victoire declaratives (optionnel).",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id":          { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "trigger":     { "type": "string" }
        }
      }
    },
    "spawn":   { "type": "object", "description": "Bloc de spawn specifique au runtime (optionnel)." },
    "economy": { "type": "object", "description": "Bloc d'economie / scoring (optionnel)." },
    "physics": { "type": "object", "description": "Parametres physiques (optionnel)." },
    "systems": {
      "type": "array",
      "description": "Systemes de simulation declaratifs (optionnel).",
      "items": { "type": "object" }
    },
    "assets": { "type": "object", "description": "Reference d'assets (optionnel)." }
  }
}

{
    "permissions":  {
                        "allow":  [
                                      "Write(studio_core/**)",
                                      "Edit(studio_core/**)",
                                      "Write(lab/chains/**)",
                                      "Edit(lab/chains/**)",
                                      "Write(studio/openclaw-workspace/**)",
                                      "Edit(studio/openclaw-workspace/**)",
                                      "Edit(autopilot.py)",
                                      "Write(.claude/**)",
                                      "Edit(.claude/**)"
                                  ]
                    },
    "hooks":  {
                  "Stop":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "bash .claude/hooks/stop-failure.sh"
                                                 }
                                             ]
                               }
                           ],
                  "PreCompact":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "bash .claude/hooks/pre-compact.sh"
                                                 }
                                             ]
                               }
                           ],
                  "PostCompact":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "bash .claude/hooks/post-compact.sh"
                                                 }
                                             ]
                               }
                           ]
              }
}

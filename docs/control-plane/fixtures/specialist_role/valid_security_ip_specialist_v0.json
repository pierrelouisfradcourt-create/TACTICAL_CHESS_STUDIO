  "human_gate_required": true,
  "active_agent_allowed": false,
  "auto_ready_allowed": false,
  "auto_merge_allowed": false,
  "auto_training_allowed": false,
  "auto_rule_mutation_allowed": false,
  "claim_verdict": "NO_CLAIM_ALLOWED",

; Projet Godot minimal — il n'existe que pour une raison : faire résoudre les
; `class_name` (DetInt, DetHash, DetRng, DetCanonical). Hors projet, Godot ne
; les enregistre pas et `godot --script` échoue sur un identifiant inconnu.
;
; Il ne contient aucune scène et ne dessine rien. C'est un banc, pas un jeu.
;
; Usage depuis ce dossier :
;     godot --headless --script run_selftest.gd
;
; Écrit le 2026-09-19 SANS Godot sur la machine d'écriture : si Godot 4.6
; réclame un `config/features`, ouvre le projet une fois dans l'éditeur, il
; l'ajoutera lui-même.

config_version=5

[application]

config/name="Chroniques de Guilde — contrôles de portage"
config/description="Vérification des primitives déterministes du portage. Aucun contenu de jeu."
run/main_scene=""

[debug]

gdscript/warnings/untyped_declaration=0

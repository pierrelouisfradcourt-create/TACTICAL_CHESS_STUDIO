; Engine configuration file.
; Projet « Qui va où » — portage de la sonde artifact V8 (2026-09-19).

config_version=5

[application]

config/name="Qui va où"
config/description="Jeu de sauvetage pour enfants. Un chaton prisonnier par tableau, des chats spécialisés pour le sortir. DOCUMENTED_ONLY / NO_CLAIM_ALLOWED."
run/main_scene="res://ui/jeu.tscn"
config/features=PackedStringArray("4.6")

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; project.godot — configuration du projet Godot (categorie godot.project_root).
; Point d'entree du jeu : run/main_scene = res://main.tscn (invariant de lancabilite R9 : le
; projet DOIT demarrer). Rendu par primitives du moteur, zero asset importe. Hors-ligne, clavier.

config_version=5

[application]

config/name="Tetris"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=480
window/size/viewport_height=560
window/stretch/mode="canvas_items"

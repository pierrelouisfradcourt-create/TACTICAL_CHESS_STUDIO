    {"phrase": "evidence proves improvement", "issue": "BLOCKED_SCIENTIFIC_PROOF_CLAIM"},
    {"phrase": "benchmark validates", "issue": "BLOCKED_OVERCLAIM_LANGUAGE"},
    {"phrase": "ready for promotion", "issue": "BLOCKED_PROMOTION_CLAIM"},
    {"phrase": "promotion candidate", "issue": "BLOCKED_PROMOTION_CLAIM"},
    {"phrase": "strength improved", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "Elo improved", "issue": "BLOCKED_ELO_CLAIM"},
    {"phrase": "search improved", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "neural improved", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "conversion proves strength", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "CI proves correctness", "issue": "BLOCKED_CI_AS_PROOF"},
    {"phrase": "latest proves", "issue": "BLOCKED_LATEST_AS_EVIDENCE"},
    {"phrase": "validated engine", "issue": "BLOCKED_OVERCLAIM_LANGUAGE"},
    {"phrase": "scientific proof", "issue": "BLOCKED_SCIENTIFIC_PROOF_CLAIM"},
    {"phrase": "stronger", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "better engine", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "global improvement", "issue": "BLOCKED_STRENGTH_CLAIM"},
    {"phrase": "AAA validated", "issue": "BLOCKED_OVERCLAIM_LANGUAGE"},
    {"phrase": "promotion eligible", "issue": "BLOCKED_PROMOTION_CLAIM"}

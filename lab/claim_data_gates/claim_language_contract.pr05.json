    "latest_json_must_not_be_used_as_evidence": true,
    "issue": "BLOCKED_LATEST_AS_EVIDENCE"
  },
  "holdout_exposure_rule": {
    "blocked_fields": [
      "holdout_position",
      "holdout_positions",
      "holdout_hash",
      "holdout_hashes",
      "holdout_ids",
      "fen",
      "move_list"
    ],
    "allowed_fields": ["holdout_set_id"],
    "issue": "BLOCKED_HOLDOUT_EXPOSURE"
  },
  "not_scientific_proof": true,
  "no_claim_authority": true,
  "no_merge_authority": true,
  "no_promotion_authority": true
}

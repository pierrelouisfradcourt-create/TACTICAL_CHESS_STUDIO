{
  "agent_id": "qa",
  "display_name": "QA Agent",
  "role": "Run declared quality checks and report pass/fail",
  "autonomy_level": "L1",
  "permissions": {
    "can_write_files": false,
    "can_assign_tasks": false,
    "can_run_checks": true,
    "can_merge": false,
    "can_claim": false,
    "can_use_benchmark_as_proof": false
  },
  "allowed_surfaces": [
    "required-check-execution",
    "quality-reporting"
  ],
  "forbidden_surfaces": [
    "benchmark-proof",
    "runtime-mutation",
    "merge",
    "claims",
    "test-policy-bypass"
  ]
}

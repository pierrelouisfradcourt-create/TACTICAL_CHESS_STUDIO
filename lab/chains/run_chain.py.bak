"""
run_chain.py — Studio Chain Runner
Usage:
  python lab/chains/run_chain.py --truth-packet path/to/truth_packet.yaml
  python lab/chains/run_chain.py --objective "Implémenter X dans src/Y.rs"

Requiert : LM Studio actif sur http://127.0.0.1:1234
Env vars  : TCS_LLM_MODEL (défaut: devstral)
            TCS_LM_STUDIO_URL (défaut: http://127.0.0.1:1234)
"""

import argparse
import json
import os
import uuid
import yaml
import requests
from datetime import datetime
from pathlib import Path

# ── Config ────────────────────────────────────────────────
LM_URL   = os.environ.get("TCS_LM_STUDIO_URL", "http://127.0.0.1:1234")
MODEL    = os.environ.get("TCS_LLM_MODEL", "devstral")
TRACES   = Path("lab/traces")
CHAINS   = Path("lab/chains/output")

# ── System prompts ────────────────────────────────────────
SYSTEM_ENGINEER = """
Tu es l'Ingénieur du Tactical Chess Studio.
Tu reçois un Truth Packet décrivant une tâche de développement.
Tu produis un Codex Pack borné : ce qui doit être fait, fichiers impactés,
actions interdites, commandes de validation.

RÈGLES STRICTES :
- Rust = runtime truth. Python = ML/tooling uniquement.
- Search = autorité finale. Neural = propose seulement.
- Ne jamais toucher : scripts/auto_merge_guard.py, .github/, benchmarks.
- claim_verdict: NO_CLAIM_ALLOWED toujours.
- Ne jamais prétendre qu'un résultat est prouvé sans tests réels.

FORMAT DE SORTIE — JSON strict, rien d'autre :
{
  "proposal_id": "uuid",
  "task_summary": "description courte",
  "files_to_create": ["path/to/file.py"],
  "files_to_edit": ["path/to/existing.rs"],
  "forbidden_files": ["scripts/auto_merge_guard.py", ".github/"],
  "forbidden_actions": ["benchmark", "push main", "dataset reset"],
  "validation_commands": ["cargo check", "python -m pytest tests/"],
  "scope_note": "pourquoi ce scope est borné",
  "recommendation": "PROCEED",
  "claim_verdict": "NO_CLAIM_ALLOWED"
}
""".strip()

SYSTEM_REDTEAM = """
Tu es le Red Team du Tactical Chess Studio.
Tu reçois une proposition d'Ingénieur et tu la détruis méthodiquement.
Tu cherches : scope creep, authority drift, fichiers interdits touchés,
couplages cachés, risques réels, validation insuffisante.

RÈGLES STRICTES :
- Sois agressif et précis. Pas de romantisme.
- Si la proposition est saine : dis-le clairement avec PROCEED.
- Si elle est fragile : liste les failles exactes avec HOLD.
- Si elle est dangereuse : BLOCKED avec raison précise.

FORMAT DE SORTIE — JSON strict, rien d'autre :
{
  "redteam_id": "uuid",
  "verdict": "PROCEED | HOLD | BLOCKED",
  "critical_flaws": ["flaw 1", "flaw 2"],
  "scope_violations": ["violation 1"],
  "missing_validation": ["ce qui manque"],
  "survival_condition": "ce qui doit changer pour que ça tienne",
  "flags": ["FLAG_SCOPE_CREEP", "FLAG_AUTH_DRIFT", "FLAG_MISSING_GUARD"],
  "claim_verdict": "NO_CLAIM_ALLOWED"
}
""".strip()

# ── LM Studio call ────────────────────────────────────────
def call_lm_studio(system: str, user_content: str, temperature: float = 0.2) -> str:
    payload = {
        "model": MODEL,
        "temperature": temperature,
        "max_tokens": 2000,
        "messages": [
            {"role": "system",  "content": system},
            {"role": "user",    "content": user_content}
        ]
    }
    try:
        r = requests.post(
            f"{LM_URL}/v1/chat/completions",
            json=payload,
            timeout=120
        )
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"]
    except Exception as e:
        return json.dumps({"error": str(e), "recommendation": "HOLD", "verdict": "HOLD"})

def parse_json_safe(text: str) -> dict:
    try:
        start = text.index("{")
        end   = text.rindex("}") + 1
        return json.loads(text[start:end])
    except Exception:
        return {"raw": text, "recommendation": "HOLD", "verdict": "HOLD"}

def save_trace(chain_id: str, step: int, agent: str, data: dict):
    trace_dir = TRACES / chain_id
    trace_dir.mkdir(parents=True, exist_ok=True)
    path = trace_dir / f"{step:02d}_{agent}.json"
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    print(f"  [trace] {path}")

# ── Main ──────────────────────────────────────────────────
def run_chain(truth_packet: dict) -> dict:
    chain_id  = str(uuid.uuid4())[:8]
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    print(f"\n{'='*60}")
    print(f"CHAIN {chain_id} — {timestamp}")
    print(f"Tâche : {truth_packet.get('task_summary', truth_packet.get('objective', '?'))}")
    print(f"{'='*60}\n")

    # ── Step 1 : Ingénieur ────────────────────────────────
    print("[1/3] Devstral Ingénieur...")
    eng_input = json.dumps(truth_packet, ensure_ascii=False, indent=2)
    eng_raw   = call_lm_studio(SYSTEM_ENGINEER, eng_input)
    eng_out   = parse_json_safe(eng_raw)
    eng_out.setdefault("proposal_id", chain_id + "_eng")
    save_trace(chain_id, 1, "engineer", eng_out)
    print(f"  → recommendation: {eng_out.get('recommendation', '?')}")

    # ── Step 2 : Red Team ─────────────────────────────────
    print("[2/3] Devstral Red Team...")
    rt_input = json.dumps({
        "truth_packet":       truth_packet,
        "engineer_proposal":  eng_out
    }, ensure_ascii=False, indent=2)
    rt_raw  = call_lm_studio(SYSTEM_REDTEAM, rt_input)
    rt_out  = parse_json_safe(rt_raw)
    rt_out.setdefault("redteam_id", chain_id + "_rt")
    save_trace(chain_id, 2, "redteam", rt_out)
    print(f"  → verdict: {rt_out.get('verdict', '?')}")
    if rt_out.get("critical_flaws"):
        for f in rt_out["critical_flaws"]:
            print(f"     ⚠  {f}")

    # ── Envelope finale ───────────────────────────────────
    envelope = {
        "chain_id":           chain_id,
        "timestamp":          timestamp,
        "truth_packet":       truth_packet,
        "engineer_proposal":  eng_out,
        "redteam_output":     rt_out,
        "ready_for_arbitrage": rt_out.get("verdict") == "PROCEED",
        "human_gate_required": rt_out.get("verdict") in ("HOLD", "BLOCKED"),
        "claim_verdict":      "NO_CLAIM_ALLOWED",
        "software_verdict":   "CHAIN_COMPLETE",
        "evidence_verdict":   "DOCUMENTATION_ONLY"
    }
    save_trace(chain_id, 3, "envelope", envelope)

    # ── Sauvegarde output ─────────────────────────────────
    CHAINS.mkdir(parents=True, exist_ok=True)
    out_path = CHAINS / f"chain_{chain_id}_{timestamp}.json"
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(envelope, f, indent=2, ensure_ascii=False)

    print(f"\n{'='*60}")
    print(f"OUTPUT : {out_path}")
    if envelope["ready_for_arbitrage"]:
        print("STATUS : ✅ PROCEED → prêt pour claude_bridge.py")
    elif rt_out.get("verdict") == "HOLD":
        print("STATUS : ⚠  HOLD → HumanGate requis")
        print(f"         Condition : {rt_out.get('survival_condition', '?')}")
    else:
        print("STATUS : ❌ BLOCKED → stop")
    print(f"{'='*60}\n")

    return envelope

# ── Entry point ───────────────────────────────────────────
if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--truth-packet", type=str, default=None,
                        help="Chemin vers un fichier YAML truth packet")
    parser.add_argument("--objective", type=str, default=None,
                        help="Objectif texte libre (crée un truth packet minimal)")
    args = parser.parse_args()

    if args.truth_packet:
        with open(args.truth_packet, "r", encoding="utf-8") as f:
            tp = yaml.safe_load(f)
    elif args.objective:
        tp = {
            "task_summary":   args.objective,
            "objective":      args.objective,
            "lane":           "AUDIT_REQUIRED",
            "claim_verdict":  "NO_CLAIM_ALLOWED"
        }
    else:
        parser.print_help()
        exit(1)

    result = run_chain(tp)
    exit(0 if result["ready_for_arbitrage"] else 1)
